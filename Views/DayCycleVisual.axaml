<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Cardinal"
             xmlns:vm="using:Cardinal.ViewModels"
             x:Class="Cardinal.Views.DayCycleVisual"
             x:DataType="vm:DayCycleVisualViewModel">

  <Grid Background="Black">
    <Border Background="Red" CornerRadius="9999" Width="200" Height="200"></Border>
  </Grid>

</UserControl>
