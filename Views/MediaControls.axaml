<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Cardinal"
             xmlns:vm="using:Cardinal.ViewModels"
             x:Class="Cardinal.Views.MediaControls"
             x:DataType="vm:MediaControlsViewModel">

    <Grid RowDefinitions="1*, 1*, 2*">
      <Grid Height="20" Background="{DynamicResource ResourceKey=DarkGray}"></Grid>
      <Slider Grid.Row="1" Name="TimeSlider"></Slider>
      <Grid Grid.Row="2" ColumnDefinitions="1*,1*,1*" Width="{Binding $parent.Bounds.Width}">
        <Label HorizontalAlignment="Left" Name="TickTime">0:0</Label>
        <Grid Grid.Column="1" ColumnDefinitions="1*,1*,1*,1*" HorizontalAlignment="Center" MinWidth="100">
          <Button Name="BackwardButton" Content="&lt;"></Button>
          <Button Name="PlayButton" Grid.Column="1" Content="Play"></Button>
          <Button Name="SpeedButton" Grid.Column="2" Content="2x"></Button>
          <Button Name="ForwardButton" Grid.Column="3" Content="&gt;"></Button>
        </Grid>
        <Button Grid.Column="2" Content="S" HorizontalAlignment="Right"></Button>
      </Grid>
    </Grid>
</UserControl>
