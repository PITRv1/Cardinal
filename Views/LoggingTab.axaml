<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Cardinal"
             xmlns:vm="using:Cardinal.ViewModels"
             x:Class="Cardinal.Views.LoggingTab"
             x:DataType="vm:LoggingTabViewModel">
  
  <Border Classes="Rounded">
    <Border Padding="20" Background="{DynamicResource ResourceKey=Black}">
      <ScrollViewer Classes="Tab" Background="Transparent">
        <StackPanel Name="LoggingStackPanel"></StackPanel>
      </ScrollViewer>
    </Border>
  </Border>

</UserControl>
