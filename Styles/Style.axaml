<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <Style Selector="Window">
                <Setter Property="FontFamily" Value="{DynamicResource ResourceKey=Pixel}"/>
        </Style>

        <Style Selector="ContentControl.TabContent">
                <Setter Property="Margin" Value="-12,-2,0,0"/>
        </Style>

        <Style Selector="Border.MatrixMapBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource ResourceKey=LightGray}"/>
        </Style>

        <Style Selector="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource ResourceKey=DarkGray}"/>
        </Style>

        <Style Selector="Border.Vertical">
                <Setter Property="BorderThickness" Value="0,8"/>
                <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style Selector="Border.Horizontal">
                <Setter Property="BorderThickness" Value="8,0"/>
                <Setter Property="Margin" Value="-8,0"/>
        </Style>

        <Style Selector="Grid.Tab">
                <Setter Property="Background" Value="{DynamicResource ResourceKey=DarkerGray}"/>
        </Style>

        <Style Selector="Grid.StaticWidget">
                <Setter Property="Background" Value="{DynamicResource ResourceKey=DarkGreen}"/>
        </Style>

        <Style Selector="Grid.StaticWidgetMenu">
                <Setter Property="Background" Value="{DynamicResource ResourceKey=Gray}"/>
        </Style>

        <Style Selector="TabItem">
                <Setter Property="Background" Value="{DynamicResource ResourceKey=DarkerGray}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ResourceKey=DarkGray}"/>
                <Setter Property="BorderThickness" Value="5"/>
                <Setter Property="Margin" Value="0,0,5,5"/>
                <Setter Property="FontSize" Value="50"/>
        </Style>

        <Style Selector="TabItem:selected">
                <Setter Property="Background" Value="{DynamicResource ResourceKey=DarkerGray}"/>
                <Setter Property="BorderThickness" Value="5,5,5,0"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                <Setter Property="IsVisible" Value="False"/>
        </Style>
</Styles>
